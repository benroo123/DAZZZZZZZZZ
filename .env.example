# Shared local infrastructure
ORBSTACK_MACHINE=dachang-dev
ORBSTACK_HOST=127.0.0.1
DATABASE_URL=postgresql://dachang:dachang@127.0.0.1:5432/dachang
REDIS_URL=redis://:dachang@127.0.0.1:6379/0
RABBITMQ_URL=amqp://dachang:dachang@127.0.0.1:5672
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_ACCESS_KEY=dachang
S3_SECRET_KEY=dachang-local-secret
S3_BUCKET=media
S3_USE_SSL=false

# API runtime
DEMO_AUTH_TOKEN=demo-user
MODEL_PROVIDER=local-deterministic
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=dachang-local-v1

# TypeScript API
TS_API_PORT=3100
TS_PUBLIC_BASE_URL=http://127.0.0.1:3100

# Python API
PY_API_PORT=8100
PY_PUBLIC_BASE_URL=http://127.0.0.1:8100

# Expo chooses either implementation without changing application code.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3100/v1
